class MimoClient {
  constructor() {
    this.k = ENCRYPTION_KEY;
    this.pkg = "info.camposha.mimo";
    this.base_url = "https://aiv1.clemy.top";
    this.models_url = "https://apps.clemy.top/ai/mimo/models.json";
    this.vision_models_url = "https://apps.clemy.top/ai/mimo/vision_v1.json";
    this.app_version = "3";
    this.engine_version = "android__15__API__35)";
    this.tz = "Asia/Jakarta";
    this.currency = "IDR";
    this.country = "ID";
    this.defaultModel = "xiaomi/mimo-v2.5-pro";

    this._initDevice();

    this.client = axios.create({
      baseURL: this.base_url,
      timeout: 60000
    });
  }

  _initDevice() {
    this.androidId = crypto.randomBytes(8).toString("hex");
    this.hwFp = crypto.randomBytes(16).toString("hex");
    this.firstInstall = Date.now() - Math.floor(Math.random() * 30 + 1) * 86400000;
  }

  _xor(data) {
    const db = Buffer.isBuffer(data) ? data : Buffer.from(String(data || ""), "utf-8");
    const out = Buffer.alloc(db.length);
    for (let i = 0; i < db.length; i++) {
      out[i] = db[i] ^ this.k[i % this.k.length];
    }
    return out;
  }

  _obfuscate(text) {
    return this._xor(text).toString("base64") + "\n";
  }

  _sign(payload, timestamp) {
    const raw = typeof payload === "object" ? JSON.stringify(payload) : String(payload);
    return crypto.createHmac("sha256", this.k).update(`${raw}:${timestamp}`).digest("base64");
  }

  _makeUuid() {
    const bytes = crypto.randomBytes(16).toString("hex");
    const parts = [
      bytes.substring(0, 8),
      bytes.substring(8, 12),
      bytes.substring(12, 16),
      bytes.substring(16, 20),
      bytes.substring(20, 32)
    ];
    return `user_fi-${this.firstInstall}_uu-${parts.join("-")}_pa-mimo_ed-full_edition_apv-${this.app_version}_anv-${this.engine_version}`;
  }

  async _resolveImage(img) {
    if (typeof img === "string" && img.startsWith("http")) {
      const res = await axios.get(img, { responseType: "arraybuffer" });
      return `data:image/jpeg;base64,${Buffer.from(res.data).toString("base64")}`;
    } else if (Buffer.isBuffer(img)) {
      return `data:image/jpeg;base64,${img.toString("base64")}`;
    } else if (typeof img === "string" && img.startsWith("data:image")) {
      return img;
    } else if (typeof img === "string") {
      return `data:image/jpeg;base64,${img}`;
    }
    return null;
  }

  async models({ mode = "chat" } = {}) {
    try {
      const url = mode === "vision" ? this.vision_models_url : this.models_url;
      const res = await axios.get(url, {
        headers: { "User-Agent": "okhttp/3.9.0" },
        timeout: 8000
      });
      const onlineModels = res?.data?.models || [];
      return {
        status: true,
        mode: mode,
        total: onlineModels.length > 0 ? onlineModels.length : MODEL_REGISTRY.length,
        models: onlineModels.length > 0 ? onlineModels : MODEL_REGISTRY
      };
    } catch {
      return {
        status: true,
        mode: mode,
        total: MODEL_REGISTRY.length,
        models: MODEL_REGISTRY
      };
    }
  }

  async chat({
    prompt,
    messages = [],
    model = this.defaultModel,
    image = null,
    systemPrompt = "",
    ...rest
  } = {}) {
    try {
      const history = [];

      if (systemPrompt) {
        history.push({ role: "system", content: systemPrompt });
      }

      if (Array.isArray(messages) && messages.length > 0) {
        for (const m of messages) {
          history.push({
            role: m.role || "user",
            content: m.content || ""
          });
        }
      }

      if (prompt) {
        history.push({ role: "user", content: String(prompt).trim() });
      }

      if (history.length === 0) {
        throw new Error("Parameter 'prompt' atau 'messages' wajib diisi.");
      }

      const isVision = Boolean(image);
      const endpoint = isVision ? "/chat-completion" : "/chat-completion-stream";

      if (isVision) {
        const resolvedImage = await this._resolveImage(image);
        const lastIdx = history.length - 1;
        const currentText = typeof history[lastIdx].content === "string" 
          ? history[lastIdx].content 
          : "Describe this image.";

        history[lastIdx].content = JSON.stringify([
          { type: "text", text: currentText },
          { type: "image_url", image_url: { url: resolvedImage } }
        ]);
      }

      const totalChars = history.reduce(
        (acc, cur) => acc + (typeof cur.content === "string" ? cur.content.length : 0),
        0
      );

      const currentTime = Date.now();
      const payload = {
        package: this._obfuscate(this.pkg),
        uuid: this._obfuscate(this._makeUuid()),
        edition: this._obfuscate("full_edition"),
        subscription: this._obfuscate("monthly"),
        order_id: "GPA.3312-4567-8901-23456",
        last_purchase_date: "2026-08-01",
        ai_model: this._obfuscate(model),
        messages: history,
        token_usage: 0,
        thread_char_count: totalChars,
        is_premium: true,
        current_language: this._obfuscate("in"),
        app_version: this._obfuscate(this.app_version),
        request_date: this._obfuscate(new Date().toISOString().split("T")[0]),
        request_time: currentTime,
        first_install: this.firstInstall,
        version: this._obfuscate(this.engine_version),
        session_requests: 1,
        current_session_ads: 0,
        android_id: this._obfuscate(this.androidId),
        hw_fp: this._obfuscate(this.hwFp),
        is_rooted: false,
        is_emulator: false,
        tz: this._obfuscate(this.tz),
        currency: this._obfuscate(this.currency),
        country: this._obfuscate(this.country),
        gpa_id: "GPA.3312-4567-8901-23456",
        extra: "",
        ...rest
      };

      const payloadStr = JSON.stringify(payload);
      const signature = this._sign(payloadStr, currentTime);

      const res = await this.client.post(endpoint, payloadStr, {
        headers: {
          "User-Agent": "okhttp/3.9.0",
          Accept: isVision ? "application/json" : "text/event-stream",
          "Content-Type": "application/json; charset=utf-8",
          "X-Signature": signature,
          "X-Timestamp": String(currentTime)
        },
        responseType: isVision ? "json" : "text"
      });

      let finalResult = "";

      if (isVision) {
        finalResult = res?.data?.choices?.[0]?.message?.content || "";
      } else {
        const lines = String(res?.data || "").split("\n");
        for (const line of lines) {
          const trimmed = line.trim();
          if (trimmed.startsWith("data: ") && !trimmed.includes("[DONE]")) {
            try {
              const chunk = JSON.parse(trimmed.slice(6));
              const textChunk = chunk?.choices?.[0]?.delta?.content || "";
              if (textChunk) finalResult += textChunk;
            } catch {}
          }
        }
      }

      history.push({ role: "assistant", content: finalResult });

      return {
        status: true,
        model: model,
        is_vision: isVision,
        result: finalResult.trim(),
        messages: history
      };
    } catch (err) {
      return {
        status: false,
        model: model,
        error: err?.response?.data || err?.message || "Gagal memproses request."
      };
    }
  }
}

export default async function handler(req, res) {
  const { action, ...params } = req.method === "GET" ? req.query : req.body;
  const validActions = ["chat", "models"];

  if (!action) {
    return res.status(400).json({
      status: false,
      error: "Parameter 'action' wajib diisi.",
      available_actions: validActions,
      usage: {
        method: "GET / POST",
        examples: [
          "/?action=chat&prompt=Halo+siapa+kamu&model=xiaomi/mimo-v2.5-pro",
          "/?action=chat&prompt=Jelaskan+gambar+ini&image=https://example.com/foto.jpg",
          "/?action=models"
        ]
      }
    });
  }

  if (!validActions.includes(action)) {
    return res.status(400).json({
      status: false,
      error: `Action tidak valid: "${action}". Pilihan: ${validActions.join(", ")}`,
      valid_actions: validActions
    });
  }

  const api = new MimoClient();

  try {
    switch (action) {
      case "models": {
        const data = await api.models({ mode: params.mode || "chat" });
        return res.status(200).json(data);
      }

      case "chat": {
        if (!params.prompt && (!params.messages || params.messages.length === 0)) {
          return res.status(400).json({
            status: false,
            error: "Parameter 'prompt' atau 'messages' wajib diisi untuk action 'chat'."
          });
        }

        const data = await api.chat({
          prompt: params.prompt,
          messages: params.messages,
          model: params.model,
          image: params.image,
          systemPrompt: params.systemPrompt,
          ...params
        });

        if (data.status) {
          return res.status(200).json(data);
        } else {
          return res.status(400).json(data);
        }
      }
    }
  } catch (error) {
    return res.status(500).json({
      status: false,
      message: "Terjadi kesalahan internal pada server.",
      error: error?.message || "Unknown Error"
    });
  }
}

export { MimoClient, MODEL_REGISTRY };